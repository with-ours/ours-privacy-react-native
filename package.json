{
  "name": "@oursprivacy/react-native",
  "version": "3.0.0",
  "description": "Official React Native Tracking Library for OursPrivacy Analytics",
  "main": "index.js",
  "types": "index.d.ts",
  "react-native": "index.js",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "qa:capture": "node scripts/capture-ingest.mjs",
    "qa:check-captures": "node scripts/check-captures.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:assertions": "node scripts/e2e-assertions.mjs"
  },
  "author": "OursPrivacy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/with-ours/ours-privacy-react-native.git"
  },
  "keywords": [
    "oursprivacy",
    "react",
    "native",
    "ios",
    "android",
    "analytics",
    "tracking",
    "sdk"
  ],
  "bugs": {
    "url": "https://github.com/with-ours/ours-privacy-react-native/issues"
  },
  "homepage": "https://github.com/with-ours/ours-privacy-react-native#readme",
  "metadata": {
    "op_lib": "react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "^0.85.3",
    "babel-jest": "^30.3.0",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "jest-fetch-mock": "^3.0.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-native": "^0.85.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/Samples/"
    ],
    "testMatch": [
      "<rootDir>/__tests__/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/jest_setup.js"
    ],
    "verbose": true,
    "haste": {
      "defaultPlatform": "ios",
      "platforms": [
        "android",
        "ios",
        "native"
      ]
    },
    "transform": {
      "^.+\\.(js|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage)/)"
    ],
    "moduleNameMapper": {
      "^oursprivacy-react-native/(.*)$": "<rootDir>/$1",
      "^oursprivacy-react-native$": "<rootDir>/index.js"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4"
  }
}
