{
  "name": "@oursprivacy/react-native",
  "version": "4.0.0",
  "description": "Official React Native Tracking Library for OursPrivacy Analytics",
  "main": "index.js",
  "types": "index.d.ts",
  "react-native": "index.js",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "qa:capture": "node scripts/capture-ingest.mjs",
    "qa:check-captures": "node scripts/check-captures.mjs",
    "e2e": "npm run e2e:android",
    "e2e:assertions": "node scripts/e2e-assertions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:android": "node scripts/run-e2e.mjs android",
    "e2e:ios": "node scripts/run-e2e.mjs ios",
    "test:runner": "node --test scripts/*.test.mjs"
  },
  "author": "OursPrivacy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/with-ours/ours-privacy-react-native.git"
  },
  "keywords": [
    "oursprivacy",
    "react",
    "native",
    "ios",
    "android",
    "analytics",
    "tracking",
    "sdk"
  ],
  "bugs": {
    "url": "https://github.com/with-ours/ours-privacy-react-native/issues"
  },
  "homepage": "https://github.com/with-ours/ours-privacy-react-native#readme",
  "metadata": {
    "op_lib": "react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.87.0",
    "babel-jest": "^30.3.0",
    "eslint": "^10.3.0",
    "globals": "^17.12.0",
    "jest": "^30.3.0",
    "jest-fetch-mock": "^3.0.3",
    "react-native": "0.87.1",
    "typescript": "^7.0.2",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "@react-native-async-storage/async-storage": "^3.1.1"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/Demo/"
    ],
    "testMatch": [
      "<rootDir>/__tests__/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/jest_setup.js"
    ],
    "verbose": true,
    "haste": {
      "defaultPlatform": "ios",
      "platforms": [
        "android",
        "ios",
        "native"
      ]
    },
    "transform": {
      "^.+\\.(js|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage)/)"
    ],
    "moduleNameMapper": {
      "^@oursprivacy/react-native/(.*)$": "<rootDir>/$1",
      "^@oursprivacy/react-native$": "<rootDir>/index.js"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "@react-native-async-storage/async-storage": "^2.2.0 || ^3.1.1"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  }
}
